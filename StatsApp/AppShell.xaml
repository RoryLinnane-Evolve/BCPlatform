<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StatsApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:StatsApp"
    Shell.FlyoutBehavior="Disabled">

    <TabBar x:Name="NavBar">
        <Tab Title="Games" Icon="games.png">
            <ShellContent ContentTemplate="{DataTemplate local:Views.Home}" />
        </Tab>
        <Tab Title="Home" Icon="home.png">
            <ShellContent ContentTemplate="{DataTemplate local:Views.Games}"/>
        </Tab>
        
    </TabBar>

</Shell>
