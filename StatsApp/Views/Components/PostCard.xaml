<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StatsApp.Views.Components.PostCard">
    
    <Border WidthRequest="500" 
            HeightRequest="200"
            Stroke="Black"
            StrokeThickness="4"
            BackgroundColor="LightGrey"
            StrokeShape="RoundRectangle 10"
            Margin="20">
        <Border.Shadow>
            <Shadow Brush="Blue" Opacity=".8" Offset="1,1"/>
        </Border.Shadow>
        <HorizontalStackLayout >
            <StackLayout WidthRequest="250" Margin="5">
                <Label FontSize="Title"  x:Name="Title"></Label>
                <Label FontSize="Subtitle"  x:Name="Description"></Label>
            </StackLayout>
            <Image x:Name="DisplayPhoto" WidthRequest="250"/>
        </HorizontalStackLayout>
    </Border>
</ContentView>
